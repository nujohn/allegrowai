---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import Lightbox from '../components/Lightbox.astro';
import { iosApps, webProjects } from '../data/projects';

const capabilities = [
  {
    title: 'Native iPhone and iPad apps',
    body: 'SwiftUI apps that ship through TestFlight to the App Store, with Android and web alongside when they’re needed. Example: BobaHub customers order ahead and pay with Apple Pay, while staff run the counter on an iPad.',
  },
  {
    title: 'AI inside the app',
    body: 'Vision and language models where they save a tap, on the device or on servers we run. Example: WhatToGet turns a photo of a handwritten list into items; Moodie Diary summarizes entries with on-device and self-hosted models.',
  },
  {
    title: 'Payments that just work',
    body: 'Card and Apple Pay checkout, automatic fee splitting, and receipts. Example: BobaHub takes real Stripe payments and routes money to each store automatically.',
  },
  {
    title: 'The backend, and keeping it running',
    body: 'Accounts, sync, push notifications, and the servers behind them, with HTTPS, monitoring, and automated deploys. Example: BobaHub runs 24/7 with security-scanned deploys.',
  },
];
---

<Base>
  <Nav />

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          <span>AllegrowAI</span>
        </div>

        <h1 class="hero-headline">
          We build iPhone apps,
          <em class="headline-accent">start to finish.</em>
        </h1>

        <p class="hero-sub">
          We build the full stack end to end, from the iPhone app to the servers behind it, and
          deploy it in the most cost-effective way for your business.
        </p>

        <div class="hero-cta-row">
          <a href="#work" class="cta-primary">See the iOS apps</a>
          <a href="#contact" class="cta-ghost">Get in touch</a>
        </div>
      </div>

      <div class="hero-proof-card">
        <div class="proof-label">Ideas we’ve brought to life</div>
        <ul class="proof-list">
          {iosApps.map((app) => (
            <li class={`proof-item proof-item--${app.status.tone}`}>
              <a href={`#${app.slug}`} class="proof-item__name">{app.name}</a>
              <span class="proof-item__status">{app.status.label}</span>
            </li>
          ))}
        </ul>
        <div class="proof-legend" aria-hidden="true">
          <span class="legend legend--live">Released</span>
          <span class="legend legend--beta">TestFlight / beta</span>
          <span class="legend legend--dev">Pre-launch</span>
        </div>
      </div>
    </div>

    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <section id="capabilities" class="capabilities-section">
    <div class="section-shell">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Capabilities</span>
      </div>
      <div class="capabilities-head">
        <h2>What we build.</h2>
        <p>
          One team that takes a product from idea to a real, paying, running thing — the app,
          the payments, the backend, and the server it all lives on.
        </p>
      </div>

      <div class="capabilities-grid">
        {capabilities.map((item) => (
          <article class="capability-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="work" class="work-section">
    <div class="section-shell work-header">
      <div class="section-label">
        <span class="label-line"></span>
        <span>iOS apps</span>
      </div>
      <h2>From the App Store to TestFlight</h2>
      <p>
        Ordered by how much work went in and how far along each one is. Every card shows where
        the app stands today, which platforms it runs on (iPhone, iPad, Android, or the web),
        and where to download or try it.
      </p>
    </div>

    {iosApps.map((project, i) => (
      <ProjectFeature project={project} reverse={i % 2 === 1} index={i} />
    ))}
  </section>

  <section id="web" class="work-section">
    <div class="section-shell work-header">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Also on the web</span>
      </div>
      <h2>Web products</h2>
      <p>
        Smaller products that run in the browser: a typing game, an iOS interview-prep program,
        and a concert-discovery site for two regions.
      </p>
    </div>

    {webProjects.map((project, i) => (
      <ProjectFeature project={project} reverse={(iosApps.length + i) % 2 === 1} index={iosApps.length + i} />
    ))}
  </section>

  <section id="approach" class="approach-section">
    <div class="section-shell approach-inner">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Approach</span>
      </div>
      <h2>How we work</h2>
      <p class="approach-lead">
        Small team, full ownership. We handle the product decisions, the code, and the
        last-mile work that makes software hold up with real users.
      </p>

      <div class="principles-grid">
        <div class="principle">
          <div class="principle-index">01</div>
          <h3>We ship, then improve</h3>
          <p>
            You get something live and usable early, then we make it better with real
            feedback — instead of waiting months for a big reveal.
          </p>
        </div>

        <div class="principle">
          <div class="principle-index">02</div>
          <h3>One team, end to end</h3>
          <p>
            App, payments, backend, and hosting from the same people. Nothing falls
            through the gap between a designer, a developer, and an ops team.
          </p>
        </div>

        <div class="principle">
          <div class="principle-index">03</div>
          <h3>It has to actually run</h3>
          <p>
            We sweat the bugs, the payments edge cases, and the deploys that most demos
            skip — because that's what earns a user's trust.
          </p>
        </div>

        <div class="principle">
          <div class="principle-index">04</div>
          <h3>Proof over promises</h3>
          <p>
            Each card says plainly where the product stands: App Store, TestFlight, live on
            the web, or pre-launch. We'd rather show you a working product than a slide deck.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <div class="section-shell contact-inner">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Work with us</span>
      </div>
      <h2>Have something you want built?</h2>
      <p class="contact-lead">
        Whether it's a customer app, a payments flow, or a product that's stuck halfway —
        tell us what you're trying to ship and we'll tell you, plainly, how we'd build it.
      </p>
      <a href="mailto:john@allegrowai.com" class="cta-primary contact-cta">john@allegrowai.com</a>
    </div>
  </section>

  <Footer />
  <Lightbox />
</Base>

<style>
  /* Sized to its content rather than the full viewport, so the first app
     starts within a scroll on desktop. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    padding: 7rem 0 3.5rem;
    overflow: hidden;
  }

  .section-shell,
  .hero-inner {
    width: min(1200px, calc(100% - 4rem));
    margin: 0 auto;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.9fr);
    gap: 3rem;
    align-items: center;
  }

  .hero-eyebrow,
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .eyebrow-dot,
  .label-line {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .label-line {
    width: 2rem;
    height: 1px;
    border-radius: 0;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  .hero-headline {
    margin: 1rem 0 1.1rem;
    font-size: clamp(2.3rem, 5vw, 4.1rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .headline-accent {
    display: block;
    text-wrap: balance;
    color: var(--color-accent);
    font-style: italic;
    font-weight: 700;
  }

  .hero-sub {
    max-width: 56ch;
    font-size: clamp(1.02rem, 1.8vw, 1.18rem);
    line-height: 1.7;
    color: #b7b0aa;
    margin: 0 0 1.75rem;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.4rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: 0.2s ease;
    border: 1px solid var(--color-border);
  }

  .cta-primary {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .cta-primary:hover {
    transform: translateY(-1px);
    background: #d4743f;
  }

  .cta-ghost {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.02);
  }

  .cta-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-proof-card {
    padding: 1.5rem;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
  }

  .proof-label {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-accent-gold);
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
  }

  .proof-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .hero-proof-card {
    --tone-live: #6fcf97;
    --tone-beta: #f0b44c;
    --tone-dev: #9e9690;
  }

  .proof-list li {
    color: var(--color-text);
    line-height: 1.5;
    font-size: 0.98rem;
    padding-left: 1.1rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .proof-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--tone-color, var(--color-accent));
  }

  .proof-item--live { --tone-color: var(--tone-live); }
  .proof-item--beta { --tone-color: var(--tone-beta); }
  .proof-item--dev  { --tone-color: var(--tone-dev); }

  .proof-item__name {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-text);
  }
  .proof-item__name:hover {
    color: var(--color-accent);
  }

  .proof-item__status {
    font-size: 0.9rem;
    color: var(--tone-color);
  }

  .proof-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .legend {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend::before {
    content: '';
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--tone-color);
  }
  .legend--live { --tone-color: var(--tone-live); }
  .legend--beta { --tone-color: var(--tone-beta); }
  .legend--dev  { --tone-color: var(--tone-dev); }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 30%, rgba(232, 131, 74, 0.14), transparent 35%),
      radial-gradient(circle at 10% 10%, rgba(200, 169, 110, 0.08), transparent 30%);
    pointer-events: none;
  }

  .capabilities-section,
  .approach-section {
    padding: 1rem 0 4rem;
  }

  .capabilities-head,
  .work-header,
  .approach-inner {
    max-width: 900px;
  }

  .capabilities-head h2,
  .work-header h2,
  .approach-inner h2 {
    margin: 0.75rem 0;
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
  }

  .capabilities-head p,
  .work-header p,
  .approach-lead {
    color: #b7b0aa;
    line-height: 1.7;
    font-size: 1.02rem;
    margin: 0;
  }

  .capabilities-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .capability-card,
  .principle {
    border: 1px solid var(--color-border);
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
    border-radius: 18px;
    padding: 1.35rem;
  }

  .capability-card h3,
  .principle h3 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }

  .capability-card p,
  .principle p {
    margin: 0;
    color: #b7b0aa;
    line-height: 1.8;
    font-size: 1rem;
  }

  .work-section {
    padding: 1.5rem 0 1rem;
  }

  .principles-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .principle-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    background: rgba(232, 131, 74, 0.12);
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }

  .contact-section {
    padding: 1.5rem 0 4.5rem;
  }

  .contact-inner {
    max-width: 760px;
  }

  .contact-inner h2 {
    margin: 1rem 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .contact-lead {
    color: #b7b0aa;
    line-height: 1.85;
    font-size: 1.04rem;
    margin-bottom: 2rem;
  }

  .contact-cta {
    font-size: 1.05rem;
  }

  @media (max-width: 900px) {
    .hero-inner,
    .capabilities-grid,
    .principles-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 6rem;
    }

    .hero-proof-card {
      padding: 1.25rem;
    }

    .proof-list {
      gap: 0.7rem;
    }

    .section-shell,
    .hero-inner {
      width: min(1200px, calc(100% - 2rem));
    }
  }
</style>
