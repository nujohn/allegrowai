---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ProjectFeature from '../components/ProjectFeature.astro';
import { projects } from '../data/projects';

const capabilities = [
  {
    title: 'Apps people actually use',
    body: 'Native iPhone and iPad apps plus fast websites. Example: BobaHub customers order ahead and pay with Apple Pay, while staff run the counter on an iPad.',
  },
  {
    title: 'Payments that just work',
    body: 'Card and Apple Pay checkout, automatic fee splitting, subscriptions, and receipts. Example: BobaHub takes real Stripe payments and routes money to each store automatically.',
  },
  {
    title: 'The plumbing behind it',
    body: 'Accounts, secure logins, databases, and push notifications — the parts that keep data correct. Example: order-ready alerts, and saved work that survives a reload.',
  },
  {
    title: 'Live, not a prototype',
    body: 'We put it on a real server with a real domain, HTTPS, and monitoring — and keep it running. Example: BobaHub runs 24/7 with automated, security-scanned deploys.',
  },
];

const proofPoints = [
  'BobaHub: live in production with real Stripe payments and apps on TestFlight',
  'ClockRacer: live on the web and iPhone at clockracer.com',
  'Interview Prep: running on the public web with secure accounts and saved work',
  'FastOrdr: an interactive restaurant-ordering demo you can click through right now',
  'Every product here is deployed and reachable — not a mockup',
];
---

<Base>
  <Nav />

  <section class="hero">
    <div class="hero-inner">
      <div class="hero-copy">
        <div class="hero-eyebrow">
          <span class="eyebrow-dot"></span>
          <span>AllegrowAI</span>
        </div>

        <h1 class="hero-headline">
          We build software that
          <em class="headline-accent">actually ships.</em>
        </h1>

        <p class="hero-sub">
          AllegrowAI designs, builds, and runs real products end to end — iPhone and iPad apps,
          websites, payments, and the servers behind them. Everything below is live and in use
          today, not a mockup.
        </p>

        <div class="hero-cta-row">
          <a href="#work" class="cta-primary">See what we've shipped</a>
          <a href="#contact" class="cta-ghost">Work with us</a>
        </div>
      </div>

      <div class="hero-proof-card">
        <div class="proof-label">Live right now</div>
        <ul class="proof-list">
          {proofPoints.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <div class="hero-glow" aria-hidden="true"></div>
  </section>

  <section id="capabilities" class="capabilities-section">
    <div class="section-shell">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Capabilities</span>
      </div>
      <div class="capabilities-head">
        <h2>What we build.</h2>
        <p>
          One team that takes a product from idea to a real, paying, running thing — the app,
          the payments, the backend, and the server it all lives on.
        </p>
      </div>

      <div class="capabilities-grid">
        {capabilities.map((item) => (
          <article class="capability-card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="work" class="work-section">
    <div class="section-shell work-header">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Selected work</span>
      </div>
      <h2>Products we've shipped</h2>
      <p>
        Every one of these is live and usable today. Each shows a different mix of what we do:
        consumer apps, payments, accounts, games, and content platforms.
      </p>
    </div>

    {projects.map((project, i) => (
      <ProjectFeature project={project} reverse={i % 2 === 1} index={i} />
    ))}
  </section>

  <section id="approach" class="approach-section">
    <div class="section-shell approach-inner">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Approach</span>
      </div>
      <h2>How we work</h2>
      <p class="approach-lead">
        Small team, full ownership. We handle the product decisions, the code, and the
        last-mile work that makes software hold up with real users.
      </p>

      <div class="principles-grid">
        <div class="principle">
          <div class="principle-index">01</div>
          <h3>We ship, then improve</h3>
          <p>
            You get something live and usable early, then we make it better with real
            feedback — instead of waiting months for a big reveal.
          </p>
        </div>

        <div class="principle">
          <div class="principle-index">02</div>
          <h3>One team, end to end</h3>
          <p>
            App, payments, backend, and hosting from the same people. Nothing falls
            through the gap between a designer, a developer, and an ops team.
          </p>
        </div>

        <div class="principle">
          <div class="principle-index">03</div>
          <h3>It has to actually run</h3>
          <p>
            We sweat the bugs, the payments edge cases, and the deploys that most demos
            skip — because that's what earns a user's trust.
          </p>
        </div>

        <div class="principle">
          <div class="principle-index">04</div>
          <h3>Proof over promises</h3>
          <p>
            Everything on this page is live and reachable. We'd rather show you a working
            product than a slide deck.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="contact-section">
    <div class="section-shell contact-inner">
      <div class="section-label">
        <span class="label-line"></span>
        <span>Work with us</span>
      </div>
      <h2>Have something you want built?</h2>
      <p class="contact-lead">
        Whether it's a customer app, a payments flow, or a product that's stuck halfway —
        tell us what you're trying to ship and we'll tell you, plainly, how we'd build it.
      </p>
      <a href="mailto:john@allegrowai.com" class="cta-primary contact-cta">john@allegrowai.com</a>
    </div>
  </section>

  <Footer />
</Base>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: 8rem 0 5rem;
    overflow: hidden;
  }

  .section-shell,
  .hero-inner {
    width: min(1200px, calc(100% - 4rem));
    margin: 0 auto;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(320px, 0.9fr);
    gap: 3rem;
    align-items: center;
  }

  .hero-eyebrow,
  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted);
  }

  .eyebrow-dot,
  .label-line {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 999px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .label-line {
    width: 2rem;
    height: 1px;
    border-radius: 0;
    background: linear-gradient(90deg, var(--color-accent), transparent);
  }

  .hero-headline {
    margin: 1.25rem 0 1.25rem;
    font-size: clamp(3.3rem, 8vw, 6.8rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
  }

  .headline-accent {
    display: block;
    color: var(--color-accent);
    font-style: italic;
    font-weight: 700;
  }

  .hero-sub {
    max-width: 56ch;
    font-size: clamp(1.02rem, 1.8vw, 1.18rem);
    line-height: 1.85;
    color: #b7b0aa;
    margin: 0 0 2rem;
  }

  .hero-cta-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cta-primary,
  .cta-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.4rem;
    border-radius: 10px;
    font-size: 0.95rem;
    font-weight: 600;
    transition: 0.2s ease;
    border: 1px solid var(--color-border);
  }

  .cta-primary {
    background: var(--color-accent);
    color: white;
    border-color: var(--color-accent);
  }

  .cta-primary:hover {
    transform: translateY(-1px);
    background: #d4743f;
  }

  .cta-ghost {
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.02);
  }

  .cta-ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero-proof-card {
    padding: 1.5rem;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    background: linear-gradient(180deg, rgba(255,255,255,0.05), rgba(255,255,255,0.02));
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.35);
  }

  .proof-label {
    font-family: var(--font-heading);
    font-size: 0.9rem;
    color: var(--color-accent-gold);
    margin-bottom: 1rem;
    letter-spacing: 0.04em;
  }

  .proof-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1rem;
  }

  .proof-list li {
    color: var(--color-text);
    line-height: 1.75;
    font-size: 0.98rem;
    padding-left: 1rem;
    position: relative;
  }

  .proof-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-accent);
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 80% 30%, rgba(232, 131, 74, 0.14), transparent 35%),
      radial-gradient(circle at 10% 10%, rgba(200, 169, 110, 0.08), transparent 30%);
    pointer-events: none;
  }

  .capabilities-section,
  .approach-section {
    padding: 2rem 0 6rem;
  }

  .capabilities-head,
  .work-header,
  .approach-inner {
    max-width: 900px;
  }

  .capabilities-head h2,
  .work-header h2,
  .approach-inner h2 {
    margin: 1rem 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .capabilities-head p,
  .work-header p,
  .approach-lead {
    color: #b7b0aa;
    line-height: 1.85;
    font-size: 1.04rem;
  }

  .capabilities-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .capability-card,
  .principle {
    border: 1px solid var(--color-border);
    background: linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.015));
    border-radius: 18px;
    padding: 1.35rem;
  }

  .capability-card h3,
  .principle h3 {
    margin: 0 0 0.75rem;
    font-size: 1.1rem;
  }

  .capability-card p,
  .principle p {
    margin: 0;
    color: #b7b0aa;
    line-height: 1.8;
    font-size: 1rem;
  }

  .work-section {
    padding: 2rem 0 3rem;
  }

  .principles-grid {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .principle-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 999px;
    margin-bottom: 1rem;
    background: rgba(232, 131, 74, 0.12);
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 0.85rem;
  }

  .contact-section {
    padding: 2rem 0 6rem;
  }

  .contact-inner {
    max-width: 760px;
  }

  .contact-inner h2 {
    margin: 1rem 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
  }

  .contact-lead {
    color: #b7b0aa;
    line-height: 1.85;
    font-size: 1.04rem;
    margin-bottom: 2rem;
  }

  .contact-cta {
    font-size: 1.05rem;
  }

  @media (max-width: 900px) {
    .hero-inner,
    .capabilities-grid,
    .principles-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      padding-top: 7rem;
    }

    .section-shell,
    .hero-inner {
      width: min(1200px, calc(100% - 2rem));
    }
  }
</style>
