---
import Base from './Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  updated?: string;
}

const { title, description, eyebrow, updated = 'June 1, 2026' } = Astro.props;
---

<Base title={`${title} | AllegrowAI`} description={description}>
  <Nav />
  <main class="legal-shell">
    <section class="legal-hero">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="updated">Last updated: {updated}</p>
    </section>
    <article class="legal-content">
      <slot />
    </article>
  </main>
  <Footer />
</Base>

<style>
  .legal-shell {
    width: min(920px, calc(100% - 2rem));
    margin: 0 auto;
    padding-top: 8rem;
  }

  .legal-hero {
    padding: 2rem 0 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2.3rem, 6vw, 4.5rem);
  }

  .lede {
    max-width: 68ch;
    margin: 1rem 0 0;
    color: #c9c2bc;
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .updated {
    margin: 1rem 0 0;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .legal-content {
    padding: 2.5rem 0 0;
    color: #d8d0c9;
  }

  .legal-content :global(h2) {
    margin: 2rem 0 0.7rem;
    font-size: 1.35rem;
  }

  .legal-content :global(p),
  .legal-content :global(li) {
    font-size: 1rem;
    line-height: 1.85;
  }

  .legal-content :global(p) {
    margin: 0 0 1rem;
  }

  .legal-content :global(ul),
  .legal-content :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.3rem;
  }

  .legal-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .legal-content :global(strong) {
    color: var(--color-text);
  }

  .legal-content :global(.notice) {
    margin: 1.5rem 0;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
  }
</style>
