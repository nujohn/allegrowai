---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  reverse?: boolean;
  index: number;
}

const { project, reverse = false, index } = Astro.props;

// Group gallery items by their optional `section` label, preserving
// order. When any item carries a section, we render each group under a
// small heading (e.g. "iPhone app" / "On the web") so a project that
// ships on multiple surfaces reads as clearly separated sets rather
// than one undifferentiated grid.
const links = project.links ?? [];
type GalleryItem = NonNullable<typeof project.gallery>[number];
const gallery = project.gallery ?? [];
const hasSections = gallery.some((g) => g.section);
const galleryGroups: Array<{ section?: string; items: GalleryItem[] }> = [];
for (const item of gallery) {
  const last = galleryGroups[galleryGroups.length - 1];
  if (last && last.section === item.section) last.items.push(item);
  else galleryGroups.push({ section: item.section, items: [item] });
}
// A group of phone screens packs many to a row; anything landscape
// (iPad, admin, web pages) gets fewer, wider tiles.
const groupShape = (items: GalleryItem[]) =>
  items.every((i) => i.mode === 'portrait') ? 'portrait' : 'landscape';
// A small set (≤ 4) sits under the lead image, beside the text, where the
// column would otherwise be empty. A long set takes the full width below.
const compact = gallery.length > 0 && gallery.length <= 4;
const isPhone = project.heroMode === 'phone';
---

<section
  class={`project-feature ${reverse ? 'project-feature--reverse' : ''} ${isPhone ? 'project-feature--phone' : ''}`}
  id={project.slug}
>
  <div class={`project-feature__inner ${compact ? 'project-feature__inner--compact' : ''}`}>

    <!-- Text side -->
    <div class="project-feature__text">
      <div class="project-feature__tags">
        {project.tags.map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>

      <span class="project-feature__number">{String(index + 1).padStart(2, '0')}</span>

      <h2 class="project-feature__name">{project.name}</h2>
      <div class={`status-pill status-pill--${project.status.tone}`}>
        <span class="status-pill__dot" aria-hidden="true"></span>
        <span>{project.status.label}</span>
      </div>
      <p class="project-feature__tagline">{project.tagline}</p>
      <p class="project-feature__description">{project.description}</p>

      <ul class="platform-list" aria-label={`${project.name} platforms`}>
        {project.platforms.map((p) => (
          <li class={`platform platform--${p.tone}`}>
            <span class="platform__name">{p.name}</span>
            <span class="platform__state">{p.state}</span>
          </li>
        ))}
      </ul>

      <ul class="project-feature__strengths">
        {project.strengths.map((s) => (
          <li class="strength-item">
            <span class="strength-bullet" aria-hidden="true"></span>
            {s}
          </li>
        ))}
      </ul>

      {links.length > 0 ? (
        <div class="project-feature__links">
          {links.map((link, i) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`project-feature__cta ${i === 0 ? 'project-feature__cta--primary' : ''}`}
            >
              {(link.kind === 'appstore' || link.kind === 'testflight' || link.kind === 'android') ? (
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M8 2.5v8M4.5 7.5 8 11l3.5-3.5M3 13.5h10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              ) : null}
              <span>{link.label}</span>
              {(link.kind === 'web' || link.kind === 'demo') ? (
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              ) : null}
            </a>
          ))}
        </div>
      ) : (
        <div class="project-feature__status">{project.note ?? 'Walkthrough on request.'}</div>
      )}
      {links.length > 0 && project.note && (
        <p class="project-feature__note">{project.note}</p>
      )}
    </div>

    <!-- Lead image -->
    <div class="project-feature__visual">
      <div class="project-feature__visual-inner">
        {project.heroMode === 'phone' ? (
          <button
            type="button"
            class="phone-frame zoomable"
            data-zoom-src={project.screenshot}
            data-zoom-alt={project.screenshotAlt}
            data-zoom-group={project.slug}
            aria-label={`Enlarge: ${project.screenshotAlt}`}
          >
            <img
              src={project.screenshot}
              alt={project.screenshotAlt}
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
            />
          </button>
        ) : (
          <button
            type="button"
            class="browser-frame zoomable"
            data-zoom-src={project.screenshot}
            data-zoom-alt={project.screenshotAlt}
            data-zoom-group={project.slug}
            aria-label={`Enlarge: ${project.screenshotAlt}`}
          >
            <div class="browser-frame__chrome">
              <div class="browser-dots">
                <span class="dot dot--red"></span>
                <span class="dot dot--yellow"></span>
                <span class="dot dot--green"></span>
              </div>
              <div class="browser-url">
                <span>{project.urlLabel ?? 'Local build'}</span>
              </div>
            </div>
            <div class="browser-frame__content">
              <img
                src={project.screenshot}
                alt={project.screenshotAlt}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </button>
        )}
        <div class="frame-glow" aria-hidden="true"></div>
      </div>
    </div>

  <!-- Supporting screens. Full width under the text + lead image for a
       long set; under the lead image for a small one (see `compact`). -->
  {gallery.length > 0 && (
    <div class="project-feature__galleries" aria-label={`${project.name} screenshots`}>
      {galleryGroups.map((group) => (
        <div class="gallery-group">
          {hasSections && group.section && (
            <div class="gallery-group__heading">
              <span class="gallery-group__dot" aria-hidden="true"></span>
              <span>{group.section}</span>
            </div>
          )}
          <div class={`gallery-grid gallery-grid--${groupShape(group.items)}`}>
            {group.items.map((item) => (
              <figure class={`gallery-card gallery-card--${item.mode ?? 'default'}`}>
                <button
                  type="button"
                  class="gallery-card__image-wrap zoomable"
                  data-zoom-src={item.src}
                  data-zoom-alt={item.alt}
                  data-zoom-caption={item.label}
                  data-zoom-group={project.slug}
                  aria-label={`Enlarge: ${item.label ?? item.alt}`}
                >
                  <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
                </button>
                {item.label && <figcaption class="gallery-card__label">{item.label}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}
  </div>
</section>

<style>
  .project-feature {
    /* Status colours: live (shipped, public), beta (TestFlight / tester
       builds), dev (built, not released). */
    --tone-live: #6fcf97;
    --tone-beta: #f0b44c;
    --tone-dev: #9e9690;
    padding: 4rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .project-feature:last-of-type {
    border-bottom: none;
  }

  /* Text and lead image side by side; the gallery takes the full width
     below (long sets) or tucks under the lead image (small sets). */
  .project-feature__inner {
    --text-col: minmax(0, 1.15fr);
    --visual-col: minmax(0, 0.85fr);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: var(--text-col) var(--visual-col);
    grid-template-areas:
      "text visual"
      "gallery gallery";
    column-gap: 3.5rem;
    row-gap: 2.5rem;
    /* Top-aligned: centring the text against the image left a band of
       empty space above the name. */
    align-items: start;
  }
  .project-feature__text { grid-area: text; }
  .project-feature__visual { grid-area: visual; }
  .project-feature__galleries { grid-area: gallery; }

  /* A phone lead image needs ~300px; the rest goes to the text so it
     wraps into fewer, longer lines. */
  .project-feature--phone .project-feature__inner {
    --text-col: minmax(0, 1fr);
    --visual-col: 320px;
  }
  .project-feature--phone .phone-frame {
    width: 290px;
  }

  .project-feature--reverse .project-feature__inner {
    grid-template-columns: var(--visual-col) var(--text-col);
    grid-template-areas:
      "visual text"
      "gallery gallery";
  }

  .project-feature__inner--compact {
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "text visual"
      "text gallery";
    row-gap: 1.25rem;
  }
  .project-feature--reverse .project-feature__inner--compact {
    grid-template-areas:
      "visual text"
      "gallery text";
  }

  /* Tags */
  .project-feature__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.22rem 0.7rem;
    border-radius: 999px;
    background: var(--color-surface-2);
    color: var(--color-accent-gold);
    border: 1px solid var(--color-border);
  }

  .project-feature__number {
    display: block;
    font-family: var(--font-heading);
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--color-border);
    letter-spacing: 0.08em;
    margin-bottom: 0.35rem;
  }

  .project-feature__name {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 800;
    color: var(--color-text);
    margin: 0 0 0.4rem;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.2rem 0 0.9rem;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    border: 1px solid currentColor;
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .status-pill__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: currentColor;
    flex-shrink: 0;
  }
  .status-pill--live { color: var(--tone-live); }
  .status-pill--beta { color: var(--tone-beta); }
  .status-pill--dev  { color: var(--tone-dev); }

  .project-feature__tagline {
    font-size: 1.08rem;
    font-weight: 500;
    color: var(--color-accent);
    margin: 0 0 0.9rem;
    font-family: var(--font-heading);
    line-height: 1.45;
  }

  .project-feature__description {
    font-size: 1rem;
    color: #b7b0aa;
    line-height: 1.7;
    margin: 0 0 1.25rem;
    max-width: 62ch;
  }

  .platform-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .platform {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    font-size: 0.8rem;
    line-height: 1.2;
  }
  .platform__name {
    padding: 0.38rem 0.6rem;
    font-weight: 600;
    color: var(--color-text);
    background: var(--color-surface-2);
  }
  .platform__state {
    padding: 0.38rem 0.6rem;
    font-weight: 500;
  }
  .platform--live .platform__state { color: var(--tone-live); }
  .platform--beta .platform__state { color: var(--tone-beta); }
  .platform--dev  .platform__state { color: var(--tone-dev); }

  .project-feature__strengths {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .strength-item {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text);
    opacity: 0.92;
  }

  .strength-bullet {
    width: 6px;
    height: 6px;
    margin-top: 0.6em;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  /* Links */
  .project-feature__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .project-feature__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-text);
    padding: 0.65rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    transition: border-color 0.2s, background 0.2s, color 0.2s;
  }
  .project-feature__cta:hover {
    border-color: var(--color-accent);
    background: var(--color-surface-2);
    color: var(--color-accent);
  }
  .project-feature__cta svg {
    transition: transform 0.2s;
  }
  .project-feature__cta:hover svg {
    transform: translateX(3px);
  }
  .project-feature__cta--primary {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
  .project-feature__cta--primary:hover {
    background: #d4743f;
    border-color: #d4743f;
    color: #fff;
  }

  .project-feature__note {
    margin: 0.75rem 0 0;
    font-size: 0.88rem;
    color: var(--color-muted);
  }

  .project-feature__status {
    display: inline-flex;
    align-items: center;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: #b7b0aa;
    font-size: 0.9rem;
    background: rgba(255, 255, 255, 0.02);
  }

  /* Lead image. Sticky on desktop so it rides beside the text. */
  .project-feature__visual {
    position: relative;
    align-self: stretch;
  }
  .project-feature__visual-inner {
    position: sticky;
    top: 5.5rem;
  }

  .zoomable {
    display: block;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    cursor: zoom-in;
  }

  .browser-frame {
    width: 100%;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px rgba(255,255,255,0.04) inset,
      0 24px 64px rgba(0,0,0,0.6),
      0 8px 24px rgba(0,0,0,0.4);
    position: relative;
    z-index: 1;
  }

  .browser-frame__chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.55rem 1rem;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
  }

  .browser-dots {
    display: flex;
    gap: 5px;
    flex-shrink: 0;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .dot--red    { background: #ff5f57; }
  .dot--yellow { background: #febc2e; }
  .dot--green  { background: #28c840; }

  .browser-url {
    flex: 1;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 5px;
    padding: 0.22rem 0.6rem;
    font-size: 0.72rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .browser-frame__content {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    display: flex;
  }

  .browser-frame__content img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  /* Portrait phone lead image (heroMode === 'phone'). */
  .phone-frame {
    width: min(290px, 68%);
    margin: 0 auto;
    aspect-ratio: 1206 / 2622;
    background: #0b0a0a;
    border: 1px solid var(--color-border);
    border-radius: 2.4rem;
    padding: 0.5rem;
    box-shadow: 0 24px 60px rgba(0,0,0,0.4);
    position: relative;
    z-index: 1;
  }

  .phone-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    border-radius: 2rem;
    display: block;
  }

  .frame-glow {
    position: absolute;
    inset: 20% 10%;
    background: radial-gradient(ellipse, rgba(232, 131, 74, 0.12), transparent 70%);
    border-radius: 50%;
    z-index: 0;
    pointer-events: none;
    filter: blur(24px);
  }

  /* Supporting screens, full width. */
  /* Groups flow side by side and wrap: two small sets (ClockRacer's iPhone
     and web shots) share a row, while a long one (BobaHub's admin console)
     wraps within its own. Cards are fixed-width so phone screens stay
     phone-sized instead of stretching. */
  .project-feature__galleries {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 1.75rem 2.25rem;
  }

  .gallery-group {
    flex: 0 1 auto;
    min-width: 0;
    max-width: 100%;
  }

  /* Under the lead image: one group per row, landscape shots share the
     column width equally, phone shots stay small. */
  .project-feature__inner--compact .project-feature__galleries {
    gap: 1.1rem;
  }
  .project-feature__inner--compact .gallery-group {
    flex-basis: 100%;
  }
  .project-feature__inner--compact .gallery-grid--landscape {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
  }
  .project-feature__inner--compact .gallery-grid--landscape .gallery-card {
    width: auto;
  }
  .project-feature__inner--compact .gallery-card--portrait {
    width: 116px;
  }

  .gallery-group__heading {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-heading);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-gold);
    margin-bottom: 0.75rem;
  }

  .gallery-group__dot {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 999px;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .gallery-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .gallery-card {
    width: 250px;
    margin: 0;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface);
    box-shadow: 0 10px 26px rgba(0,0,0,0.22);
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s, transform 0.2s;
  }
  .gallery-card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .gallery-card__image-wrap {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .gallery-card__image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .gallery-card--portrait {
    width: 148px;
  }
  .gallery-card--wide {
    width: 320px;
  }

  .gallery-card--portrait .gallery-card__image-wrap {
    aspect-ratio: 1 / 2;
    background: #121110;
    padding: 0.4rem;
  }
  .gallery-card--portrait .gallery-card__image-wrap img,
  .gallery-card--wide .gallery-card__image-wrap img {
    object-fit: contain;
    object-position: center;
  }
  .gallery-card--wide .gallery-card__image-wrap {
    aspect-ratio: 16 / 10;
    background: #121110;
  }

  .gallery-card__label {
    padding: 0.5rem 0.65rem;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--color-accent-gold);
    background: rgba(255,255,255,0.02);
    border-top: 1px solid var(--color-border);
  }

  /* Tablet and phone: one column, lead image first. */
  @media (max-width: 900px) {
    .project-feature {
      padding: 3rem 0;
    }
    .project-feature__inner,
    .project-feature--phone .project-feature__inner,
    .project-feature--reverse .project-feature__inner,
    .project-feature__inner--compact,
    .project-feature--reverse .project-feature__inner--compact {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto;
      grid-template-areas:
        "visual"
        "text"
        "gallery";
      row-gap: 1.75rem;
    }
    .project-feature--phone .phone-frame {
      width: min(240px, 62%);
    }
    .project-feature__visual-inner {
      position: static;
    }
    .phone-frame {
      width: min(240px, 62%);
    }
    .frame-glow {
      display: none;
    }
    .project-feature__description {
      max-width: none;
    }
  }

  /* Phone: each gallery group is a swipeable row instead of a stack of
     full-width screenshots. */
  @media (max-width: 640px) {
    .project-feature {
      padding: 2.5rem 0;
    }
    .project-feature__inner {
      padding: 0 1rem;
    }
    .gallery-group {
      flex-basis: 100%;
    }
    .gallery-card,
    .gallery-card--portrait,
    .gallery-card--wide {
      width: auto;
    }
    .gallery-grid,
    .gallery-grid--portrait,
    .gallery-grid--landscape {
      display: grid;
      grid-auto-flow: column;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      /* Let the row run to the screen edge while its first card lines up
         with the text above. */
      margin: 0 -1rem;
      padding: 0.25rem 1rem 0.5rem;
      scroll-padding: 0 1rem;
    }
    .gallery-grid::-webkit-scrollbar {
      display: none;
    }
    .gallery-grid--portrait {
      grid-auto-columns: 42%;
    }
    .gallery-grid--landscape {
      grid-auto-columns: 84%;
    }
    .gallery-card {
      scroll-snap-align: start;
    }
    .gallery-card:hover {
      transform: none;
    }
  }
</style>
